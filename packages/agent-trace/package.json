{
  "name": "agent-trace",
  "version": "0.1.0",
  "type": "module",
  "description": "Optional local agent execution collection and evidence archive",
  "bin": {
    "agent-trace": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "fixtures/codex/demo.jsonl",
    "examples",
    "skills",
    "agent-trace.content.example.json",
    "agent-trace.service.example.json"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "cli": "node src/cli.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run build",
    "verify:consumers": "node scripts/verify-consumers.ts",
    "verify:follow": "node scripts/verify-follow.ts",
    "install:content": "node --experimental-strip-types scripts/install-content-service.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
