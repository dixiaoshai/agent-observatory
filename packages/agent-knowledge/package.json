{
  "name": "agent-knowledge",
  "version": "0.1.0",
  "type": "module",
  "description": "Local source-backed knowledge retrieval for agents",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "knowrelay": "dist/interfaces/cli.js",
    "agent-knowledge": "dist/interfaces/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "cli": "node --import tsx src/interfaces/cli.ts",
    "verify:codex": "npm run build && node scripts/verify-codex.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ignore": "7.0.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    "fixtures/knowledge",
    "fixtures/code",
    "skills",
    "agent-knowledge.example.json",
    "agent-knowledge.follow.example.json"
  ]
}
