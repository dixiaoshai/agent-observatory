{
  "name": "agent-journal",
  "version": "0.1.0",
  "type": "module",
  "description": "Independent daily reviews from normalized activities or optional Trace archives",
  "bin": {
    "agent-journal": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    "skills",
    "agent-journal.example.json"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "cli": "node src/cli.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "install-service": "node --experimental-strip-types scripts/install-macos-service.ts",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
